# Copy to .env for local dev. On the production host set these as environment variables.
# With NODE_ENV=production the server refuses to start if JWT secrets, MONGO_URI,
# Razorpay keys are missing, PAYMENT_GATEWAY is not razorpay, or MAIL_DRIVER=log.

# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Fitzenix
APP_WEB_URL=https://www.fitzenix.app
SUPPORT_EMAIL=support@fitzenix.app
LEADS_EMAIL=
# Extra allowed browser origins, comma separated (mobile app needs none)
CORS_ORIGINS=
# Set to true to expose /api/docs in production
ENABLE_API_DOCS=false

# ── Database ───────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/fitzenix

# ── JWT ────────────────────────────────────────────────
# Generate each with: openssl rand -hex 64  (must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Password / OTP ─────────────────────────────────────
BCRYPT_ROUNDS=10
OTP_TTL_SECONDS=600

# ── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Razorpay ───────────────────────────────────────────
# mock = local only. Production must be razorpay with rzp_live_ keys.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://api.fitzenix.app/api/v1/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Email ──────────────────────────────────────────────
# zeptomail | zeptomail_api | resend | zoho | log (log = local only)
MAIL_DRIVER=zeptomail
MAIL_FROM_NAME=Fitzenix
MAIL_FROM_EMAIL=noreply@fitzenix.app
MAIL_REPLY_TO=
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
RESEND_API_KEY=

# ── File uploads ───────────────────────────────────────
# local | s3 | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=fitzenix
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Firebase Cloud Messaging ───────────────────────────
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private_key from the service-account JSON; keep \n escapes
FIREBASE_PRIVATE_KEY=

# ── Redis (optional) ───────────────────────────────────
REDIS_URL=
