{
  "info": {
    "_postman_id": "fitzenix-api-collection-v1",
    "name": "Fitzenix API",
    "description": "Fitzenix Express API (/api/v1).\n\nHow to use:\n1. Import this file into Postman (Import → Upload Files).\n2. Set collection variables: baseUrl, email, password, gymId.\n3. Run Auth → Login — it auto-saves accessToken + refreshToken.\n4. For super_admin tenant routes, set gymId (sent as X-Gym-Id).\n\nMoney amounts are INR paise integers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "origin", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "gymId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "trainerId", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "subscriptionId", "value": "" },
    { "key": "workoutId", "value": "" },
    { "key": "dietId", "value": "" },
    { "key": "progressId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "feedId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "email", "value": "owner@fitzenix.com" },
    { "key": "password", "value": "Secret123!" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. App",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{origin}}/health"
          }
        },
        {
          "name": "API Root",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Swagger Docs",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{origin}}/api/docs"
          }
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{origin}}/api/docs.json"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (gym owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  const d = j.data || j;",
                  "  if (d.accessToken) pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  if (d.refreshToken) pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "  if (d.user && d.user._id) pm.collectionVariables.set('userId', d.user._id);",
                  "  if (d.user && d.user.gymId) pm.collectionVariables.set('gymId', d.user.gymId);",
                  "  if (d.gym && d.gym._id) pm.collectionVariables.set('gymId', d.gym._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"+919876543210\",\n  \"gymName\": \"Iron Temple Gym\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  const d = j.data || j;",
                  "  if (d.accessToken) pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  if (d.refreshToken) pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "  if (d.user && d.user._id) pm.collectionVariables.set('userId', d.user._id);",
                  "  if (d.user && d.user.gymId) pm.collectionVariables.set('gymId', String(d.user.gymId));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  const d = j.data || j;",
                  "  if (d.accessToken) pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  if (d.refreshToken) pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-reset-token-here\",\n  \"password\": \"NewSecret123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/reset-password"
          }
        },
        {
          "name": "OTP Request",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"purpose\": \"login\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/request"
          }
        },
        {
          "name": "OTP Verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  const d = j.data || j;",
                  "  if (d.accessToken) pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  if (d.refreshToken) pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"123456\",\n  \"purpose\": \"login\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/verify"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"NewerSecret123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/change-password"
          }
        },
        {
          "name": "Logout All Devices",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout-all"
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Gym-Id", "value": "{{gymId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"phone\": \"+919876543210\",\n  \"memberProfile\": {\n    \"dateOfBirth\": \"1995-06-15\",\n    \"gender\": \"male\",\n    \"heightCm\": 178,\n    \"weightKg\": 72,\n    \"goals\": [\"fat_loss\", \"strength\"],\n    \"emergencyContact\": { \"name\": \"Anita\", \"phone\": \"+919811122233\" }\n  }\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Gym-Id", "value": "{{gymId}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": [],
                  "description": "JPEG/PNG/WEBP/GIF, max 5MB"
                }
              ]
            },
            "url": "{{baseUrl}}/users/me/avatar"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Gym-Id", "value": "{{gymId}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20&role=member&status=active&search=",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "role", "value": "member" },
                { "key": "status", "value": "active" },
                { "key": "search", "value": "" },
                { "key": "gymId", "value": "{{gymId}}", "disabled": true },
                { "key": "sort", "value": "createdAt", "disabled": true },
                { "key": "order", "value": "desc", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create User (member/trainer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  const d = j.data || j;",
                  "  const id = d._id || (d.user && d.user._id);",
                  "  if (id) {",
                  "    pm.collectionVariables.set('userId', id);",
                  "    pm.collectionVariables.set('memberId', id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Gym-Id", "value": "{{gymId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Neha Kapoor\",\n  \"email\": \"neha@example.com\",\n  \"password\": \"Member123!\",\n  \"phone\": \"+919700011122\",\n  \"role\": \"member\",\n  \"gymId\": \"{{gymId}}\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Gym-Id", "value": "{{gymId}}" }],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Gym-Id", "value": "{{gymId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Neha Kapoor\",\n  \"phone\": \"+919700011122\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-Gym-Id", "value": "{{gymId}}" }],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
